# App runtime connection string (Neon driver, read in app/lib/db/client.ts)
DATABASE_URL="postgres://...neon.tech/movielist"

# Auth.js session encryption — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand--base64-32-output"

# TMDB API key (server-side only, read in app/api/tmdb/search/route.ts)
TMDB_API_KEY="from-tmdb-account-settings"

# Test database — used by integration tests (tests/integration/setup.ts), never the app itself.
# Option A: a dedicated Neon branch's connection string.
# Option B: local Docker Postgres, e.g. docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16
TEST_DATABASE_URL="postgres://...neon.tech/movielist_test"

# Target database for drizzle-kit (push/generate/migrate), read by drizzle.config.ts.
# Deliberately NOT defaulted to DATABASE_URL: the config refuses to run when this is
# unset, so a schema change is never silently pushed to the app's default database.
# Normally passed per-invocation rather than committed to .env.local, e.g.
#   DRIZZLE_TARGET_URL="$TEST_DATABASE_URL" npx drizzle-kit push
DRIZZLE_TARGET_URL=""